# Real bot runtime; no mock app. Registry-owned credentials and writable private media.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /bot
RUN apt-get update && apt-get install -y --no-install-recommends gcc && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
# Catch import-free syntax issues during Codespaces image construction.
RUN python -m compileall -q /bot
RUN groupadd --system --gid 10001 shop && useradd --system --uid 10001 --gid shop --home /bot shop     && mkdir -p /bot/static /bot/media_data && chown shop:shop /bot/static /bot/media_data
USER shop
EXPOSE 5000
CMD ["python", "-m", "uvicorn", "scripts.secure_app:app", "--host", "0.0.0.0", "--port", "5000"]
