{
  "name": "Telegram + Bale shop (Codespaces)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [
    3000,
    8080
  ],
  "portsAttributes": {
    "3000": {
      "label": "Private Next.js administration",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "8080": {
      "label": "Webhook ingress; set public only after consent",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "python3 scripts/codespace_setup.py info",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "secrets": {
    "TELEGRAM_BOT_TOKEN": {
      "description": "Token of a dedicated test bot from Telegram BotFather"
    },
    "BALE_BOT_TOKEN": {
      "description": "Token of a dedicated test bot from Bale BotFather"
    }
  }
}
