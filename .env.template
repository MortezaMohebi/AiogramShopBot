# Bot credentials and receiver modes are managed through Dashboard > Bots.
# A fresh installation has zero bots; all provider dispatch stays disabled.
WEBAPP_HOST = "0.0.0.0"
WEBAPP_PORT = "5000"
POSTGRES_USER = "postgres"
POSTGRES_PASSWORD = ""
DB_PORT = "5432"
DB_HOST = "postgres"
POSTGRES_DB = "aiogram-shop-bot"
RUNTIME_ENVIRONMENT = "PROD"
REDIS_PASSWORD = ""
REDIS_HOST = "redis"
# Registry receivers and per-Bot outbound relay routes are independently opt-in.
MULTIBOT_V2_RUNTIME_ENABLED = "false"
SHOP_RELAY_POOL_ENABLED = "false"
# Server-approved Worker origins separated by commas; no credentials/paths.
TELEGRAM_WORKER_ALLOWED_ORIGINS = ""
# Public HTTPS Webhook origin used by P4 after explicit provider cutover.
MULTIBOT_WEBHOOK_BASE_URL = ""
# Do not enable before live shipping/checkout verification and provider tests.
BALE_WALLET_CHECKOUT_ENABLED = "false"
# Store is always priced in IRR. TOMAN only changes display text.
SHOP_DISPLAY_UNIT = "IRR"
SHOP_CURRENCY_LABEL = "ریال"
SHOP_MEDIA_ROOT = "./media_data"
# Hard platform cap: photos 10 MB, other media 50 MB by multipart.
SHOP_MEDIA_MAX_BYTES = "50000000"
# Provision staff after schema migration:
# python -m scripts.manage_shop_staff add shopowner --role superadmin

# Checkout stays disabled until final tests and merchant onboarding.
TELEGRAM_FIAT_CHECKOUT_ENABLED = "false"
# Must be confirmed using the gateway's actual currency exponent.
TELEGRAM_IRR_MINOR_MULTIPLIER = "0"
TELEGRAM_STARS_CHECKOUT_ENABLED = "false"
TELEGRAM_STARS_REFUNDS_ENABLED = "false"

# Admin finance adjustments stay disabled until a safe per-operation cap is set.
SHOP_WALLET_MAX_ADMIN_ADJUSTMENT_IRR = "0"

# Secure cookies are required on the public HTTPS admin domain.
SHOP_ADMIN_SECURE_COOKIES = "true"

# Never log SQL parameters containing payment/PII data in production.
DB_SQL_ECHO = "false"

# Outbound broadcasts are opt-in only; enable after final API verification.
SHOP_CAMPAIGN_DISPATCH_ENABLED = "false"

# Regular Bale broadcast by default; paid Business API requires explicit opt-in.
BALE_BROADCAST_MODE = "standard"
BALE_BROADCAST_PAID_ENABLED = "false"

# Durable Broadcast remains OFF until the final Telegram/Bale live tests.
# After approval, one shared Worker automatically drains every campaign.
SHOP_BROADCAST_WORKER_ENABLED = "false"
# Opt-in per-Bot Registry transport; also requires worker + dispatch flags.
SHOP_BROADCAST_REGISTRY_ENABLED = "false"
# Deliberately conservative initial caps, independently configurable by channel.
SHOP_BROADCAST_TELEGRAM_MPS = "5"
SHOP_BROADCAST_BALE_STANDARD_MPS = "1"
SHOP_BROADCAST_BALE_BUSINESS_MPS = "5"
# Zero is a hard fail-closed ceiling for paid Bale Business API.
# A positive ceiling also requires per-campaign approval of exact call count.
SHOP_BROADCAST_MAX_PAID_CALLS = "0"
SHOP_BROADCAST_POLL_SECONDS = "2"
SHOP_BROADCAST_STALE_SECONDS = "900"

# Optional Next.js dashboard bridge, server-to-server only.
# Generate a strong random secret (32+ characters); never commit its value.
NEXT_ADMIN_BRIDGE_ENABLED = "false"
NEXT_ADMIN_BRIDGE_SECRET = ""
# Fernet key for encrypted credentials and MFA; generate with cryptography.
SHOP_SECURITY_ENCRYPTION_KEY = ""
# HTTPS origin for the optional webhook-only edge. Dashboard stays private.
WEBHOOK_DOMAIN = ""

# One shared Runtime worker drains queues only after global and tenant opt-in.
SHOP_WORKFLOW_RUNTIME_ENABLED = "false"
SHOP_WORKFLOW_RUNTIME_KILL_SWITCH = "false"
