# Copy to .env.next-admin ONLY during the final integration phase.
# Distinct random 32+ character secrets; do not put real values in Git.
NEXT_ADMIN_BRIDGE_SECRET=
NEXT_ADMIN_SESSION_SECRET=
# Optional old SQLAdmin URL for emergency fallback during final acceptance.
LEGACY_ADMIN_PUBLIC_URL=

# Exact public HTTPS origin (no slash), required for upload CSRF checks.
NEXT_ADMIN_PUBLIC_ORIGIN=
