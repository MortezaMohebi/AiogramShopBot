# Copy to .env.next-admin ONLY during the final integration phase.
# Distinct random 32+ character secrets; do not put real values in Git.
NEXT_ADMIN_BRIDGE_SECRET=
NEXT_ADMIN_SESSION_SECRET=
# Login CAPTCHA is optional, but NEVER bypassed if configured.
# Choose none | turnstile | recaptcha_v2 | recaptcha_v3.
NEXT_ADMIN_CAPTCHA_PROVIDER=none
NEXT_ADMIN_CAPTCHA_SITE_KEY=
NEXT_ADMIN_CAPTCHA_SECRET_KEY=
NEXT_ADMIN_RECAPTCHA_V3_MIN_SCORE=0.5

# Optional BUILD-TIME HTTPS CDN for /_next/static only (see guide).
# In Compose, pass NEXT_ADMIN_CDN_URL through the build arg, not env_file.
NEXT_ADMIN_CDN_URL=

# Optional old SQLAdmin URL for emergency fallback during final acceptance.
LEGACY_ADMIN_PUBLIC_URL=

# Exact public HTTPS origin (no slash), required for upload CSRF checks.
NEXT_ADMIN_PUBLIC_ORIGIN=
