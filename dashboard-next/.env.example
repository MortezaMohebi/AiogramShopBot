# Used ONLY on the Next.js server, never prefixed with NEXT_PUBLIC_.
SHOP_FASTAPI_INTERNAL_URL=http://bot:5000
# Must equal Python's NEXT_ADMIN_BRIDGE_SECRET (random >=32 characters).
NEXT_ADMIN_BRIDGE_SECRET=
# Different strong random 32+ char secret for Next.js cookie signatures.
NEXT_ADMIN_SESSION_SECRET=
# Production HTTPS is mandatory; cookies become Secure in production.
# Exact public HTTPS origin, e.g. https://admin.example.com (no slash).
# Required for 50MB browser multipart POST Origin verification.
NEXT_ADMIN_PUBLIC_ORIGIN=

# Login CAPTCHA: none (default), turnstile, recaptcha_v2 or recaptcha_v3.
# Site key is public; secret key is ALWAYS server-side, never NEXT_PUBLIC_.
# Enabling CAPTCHA requires both keys and NEXT_ADMIN_PUBLIC_ORIGIN.
NEXT_ADMIN_CAPTCHA_PROVIDER=none
NEXT_ADMIN_CAPTCHA_SITE_KEY=
NEXT_ADMIN_CAPTCHA_SECRET_KEY=
# Used for reCAPTCHA v3 only; allowed range 0..1.
NEXT_ADMIN_RECAPTCHA_V3_MIN_SCORE=0.5

# Optional BUILD-TIME immutable Next.js asset CDN (HTTPS origin).
# Leave empty for fully local, CDN-free operation.
NEXT_ADMIN_CDN_URL=

# Optional old SQLAdmin URL for emergency fallback during acceptance.
LEGACY_ADMIN_PUBLIC_URL=
